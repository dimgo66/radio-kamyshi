# Общие настройки
PROJECT_NAME=Radio Kamyshi
SERVER_HOST=http://localhost
SERVER_PORT=8000
API_PREFIX=/api/v1
DEBUG=True

# Настройки безопасности
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# База данных PostgreSQL
POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=radio_kamyshi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP для отправки почты
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAILS_FROM_EMAIL=info@radiokamyshi.com
EMAILS_FROM_NAME=Radio Kamyshi

# Настройки хранилища файлов
STORAGE_DIR=/app/storage
ALLOWED_UPLOAD_FORMATS=mp3,wav,aac,flac,ogg

# Первый суперпользователь
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin

# Настройки Icecast
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=hackmesource
ICECAST_ADMIN_PASSWORD=hackmeadmin
ICECAST_RELAY_PASSWORD=hackmerelay
ICECAST_MOUNT=/radio.mp3
ICECAST_STREAM_URL=http://${ICECAST_HOST}:${ICECAST_PORT}${ICECAST_MOUNT}

# Frontend
FRONTEND_URL=http://localhost:3000 